# Create a bot with @BotFather. Store the token here; do not send it in chat.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID; separate multiple IDs with commas.
ALLOWED_USER_IDS=
BOT_API_LOCAL=false
BOT_API_BASE_URL=https://api.telegram.org
BOT_API_FILE_ROOT=
MAX_INPUT_MB=20
# Direct Mini App upload on the webhook service; does not change Telegram getFile's limit.
MAX_WEB_INPUT_MB=200
MAX_OUTPUT_MB=50
MAX_DURATION_SECONDS=600
MAX_PIXELS=8294400
MAX_JOBS=1
VIDEO_CRF=16
VIDEO_PRESET=slow
FFMPEG_THREADS=2
PROCESS_TIMEOUT_SECONDS=1800
WORK_DIR=work
# Optional large output delivery with cloud webhook (Render Free):
# TELEGRAM_LARGE_FILES=true
# MAX_OUTPUT_MB=500
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# Keep BOT_API_LOCAL=false; input cloud getFile limit remains 20 MiB.
# API keys also support compose.local.yaml, which runs a full local Bot API:
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# BOT_API_REF=master

# Optional for HTTP webhook (Render Blueprint supplies WEBHOOK_SECRET):
# WEBHOOK_SECRET=
# APP_BASE_URL=https://your-service.onrender.com
# PORT=10000
# ACTIVE_JOB_HEARTBEAT_SECONDS=240
